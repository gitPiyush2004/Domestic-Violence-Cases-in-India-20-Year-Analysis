// ===========================================================================
// 05 - RISK ZONES, RANKING AND THE PRIORITY MATRIX
// ===========================================================================
// The second segmentation, and the one that disagrees with ABC on purpose.
//
// ABC bands by volume; risk zones band by intensity (cases per lakh women).
// Thresholds are the quartiles of the 2021 rate distribution, taken from
// data/processed/risk_thresholds.json - 2.5 / 9.1 / 22.9. They are quartiles
// rather than round numbers deliberately: round thresholds encode an opinion
// about what counts as "high", quartiles let the distribution speak and survive
// a data refresh without the bands quietly changing meaning.
//
// Where the two segmentations disagree is the finding. A state that is Class C
// on volume but Critical on intensity is small and badly affected, and every
// volume-ranked league table in the country buries it.
// ===========================================================================


// --- Thresholds as measures ------------------------------------------------
// Kept as named measures rather than magic numbers inside the SWITCH so the
// banding logic and the reference lines on the scatter chart cannot drift apart.
Risk Threshold Moderate = 2.5
Risk Threshold High     = 9.1
Risk Threshold Critical = 22.9


// --- Live banding ----------------------------------------------------------
Risk Zone =
VAR Rate = [DV Rate per Lakh Women (Annual Avg)]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Rate ),                 BLANK (),
        Rate >= [Risk Threshold Critical], "Critical",
        Rate >= [Risk Threshold High],     "High",
        Rate >= [Risk Threshold Moderate], "Moderate",
                                           "Low"
    )

// Numeric companion for conditional formatting and for sorting a legend into
// severity order instead of alphabetical order.
Risk Zone Rank =
SWITCH ( [Risk Zone], "Critical", 1, "High", 2, "Moderate", 3, "Low", 4, 9 )


// --- Ranking ---------------------------------------------------------------
// ALLSELECTED so the rank is relative to the states the user has left visible.
// DENSE so that filtering to ten states gives ranks 1-10, not the original
// national ranks scattered with gaps.
DV Rank =
IF (
    NOT ISBLANK ( [DV Cases] ),
    RANKX ( ALLSELECTED ( DimState[State] ), [DV Cases], , DESC, DENSE )
)

DV Rate Rank =
IF (
    NOT ISBLANK ( [DV Cases] ),
    RANKX (
        ALLSELECTED ( DimState[State] ),
        [DV Rate per Lakh Women (Annual Avg)],
        ,
        DESC,
        DENSE
    )
)


// --- The volume / intensity gap -------------------------------------------
// The single number that proves volume ranking alone is insufficient. A large
// positive value means the state is far more intense than its case count
// suggests - it is being missed by every league table.
Volume vs Intensity Gap = [DV Rank] - [DV Rate Rank]


// --- Rank momentum ---------------------------------------------------------
// Where a state ranked in the first visible year against the last. Negative
// means it climbed the table (got worse relative to its peers).
DV Rank First Year =
VAR FirstYear = MINX ( ALLSELECTED ( DimYear[Year] ), DimYear[Year] )
RETURN
    CALCULATE (
        RANKX ( ALLSELECTED ( DimState[State] ), [DV Cases], , DESC, DENSE ),
        FILTER ( ALL ( DimYear[Year] ), DimYear[Year] = FirstYear )
    )

DV Rank Last Year =
VAR LastYear = MAXX ( ALLSELECTED ( DimYear[Year] ), DimYear[Year] )
RETURN
    CALCULATE (
        RANKX ( ALLSELECTED ( DimState[State] ), [DV Cases], , DESC, DENSE ),
        FILTER ( ALL ( DimYear[Year] ), DimYear[Year] = LastYear )
    )

DV Rank Momentum = [DV Rank First Year] - [DV Rank Last Year]


// --- Priority matrix -------------------------------------------------------
// Crosses the two segmentations into the recommendation the dashboard exists to
// make. Volume decides how much resource a state needs; intensity and trend
// decide how urgently.
Priority Segment =
VAR Class   = [ABC Class]
VAR Zone    = [Risk Zone]
VAR Growing = [DV CAGR %] > 0
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Class ) || ISBLANK ( Zone ), BLANK (),
        Class = "A" && Zone IN { "Critical", "High" },
            "P1 - Scale intervention (high volume, high intensity)",
        Class = "A",
            "P2 - Sustain capacity (high volume, contained intensity)",
        Zone IN { "Critical", "High" },
            "P3 - Targeted intervention (small entity, high intensity)",
        Growing,
            "P4 - Monitor (low now, rising)",
            "P5 - Maintain"
    )


// --- Narrative card --------------------------------------------------------
// Writes the sentence for whichever state is selected, so the deep-dive page
// explains itself during a demo instead of needing one annotation per state.
//
// Always returns a string, and that matters. The first version used SELECTEDVALUE
// with no default inside an IF with no else branch, so with no single state
// selected it returned BLANK - and the card rendered as an error tile rather than
// as empty. Every numeric goes through FORMAT rather than relying on implicit
// conversion in the & operator, and every branch produces text.
State Verdict =
VAR St      = SELECTEDVALUE ( DimState[State], "" )
VAR Cases   = COALESCE ( [DV Cases], 0 )
VAR Rate    = COALESCE ( [DV Rate per Lakh Women (Annual Avg)], 0 )
VAR RankVol = COALESCE ( [DV Rank], 0 )
VAR RankInt = COALESCE ( [DV Rate Rank], 0 )
RETURN
    IF (
        St = "" || Cases = 0,
        "Select a single state to see its verdict",
        St & ": " & FORMAT ( Cases, "#,0" ) & " cases. Rank " & FORMAT ( RankVol, "0" )
            & " by volume, rank " & FORMAT ( RankInt, "0" ) & " by intensity ("
            & FORMAT ( Rate, "0.0" ) & " per lakh women a year)."
    )
