# Binary assets: never diff them, never line-ending-normalise them.
*.png  binary
*.pdf  binary

# The VBA module is opened by the Windows VBA editor, which expects CRLF on
# checkout. Storage stays LF; only the working copy differs.
*.bas  text eol=crlf

# Generated by dashboard/build_data.py - review the generator, not the output.
dashboard/data.js         linguist-generated=true
powerbi-showcase/data.js  linguist-generated=true

# The Power BI report layout is emitted by powerbi/generate_report.ps1. It is a
# build artefact: reviewing it line by line is meaningless and it dominates any
# diff it appears in.
powerbi/DomesticViolence.Report/report.json  linguist-generated=true
